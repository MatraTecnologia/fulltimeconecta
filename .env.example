DATABASE_URL="postgresql://usuario:senha@host:5432/neuroconecta?schema=public"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
# E-mail da conta de moderação criada pelo seed (npm run db:seed)
ADMIN_EMAIL="admin@fulltime.com.br"
ADMIN_PASSWORD=""
# false = não cria profissionais e famílias de demonstração
SEED_DEMO="true"

# Cloudflare R2 (fotos, vídeos e documentos)
# CORS dos dois buckets: AllowedOrigins = BETTER_AUTH_URL, AllowedMethods = PUT, GET, HEAD, AllowedHeaders = content-type
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Bucket privado (sem acesso público) para documentos de verificação
R2_PRIVATE_BUCKET=""
# URL pública do bucket (r2.dev ou domínio próprio), sem barra final
R2_PUBLIC_URL=""
